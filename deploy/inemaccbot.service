[Unit]
Description=inemaccbot - Telegram e fila persistente
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projetos/inemaccbot
EnvironmentFile=%h/projetos/inemaccbot/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=default.target
