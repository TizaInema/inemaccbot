# Preencha somente no servidor. Nunca versione o arquivo .env real.
BOT_TOKEN=
# IDs de chats autorizados, separados por vírgula. Obrigatório.
ALLOWED_CHAT_IDS=
MOTOR_PADRAO=codex
MODELO_PADRAO=sonnet
ESFORCO_PADRAO=low
CODEX_BIN=/usr/local/bin/codex
CLAUDE_BIN=/usr/bin/claude
INEMACCBOT_CPU_MEDIA=1
INEMACCBOT_WRITE_DIRS=/root/projetos/inemaccbot/state:/root/projetos/output
PROJETOS_DIR=/root/projetos
STATE_DIR=/root/projetos/inemaccbot/state
QUEUE_DB=/root/projetos/inemaccbot/inemaccbot.db
LOG_FILE=/root/projetos/inemaccbot/state/inemaccbot.log
PUBLICO_DIR=/root/projetos/output
